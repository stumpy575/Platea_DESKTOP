<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" styleClass="color-crema" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.EventsController">
   <top>
      <HBox prefHeight="40.0" prefWidth="600.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="altea-title" text="Altea">
               <font>
                  <Font name="System Bold" size="31.0" />
               </font>
            </Label>
            <Label alignment="CENTER" styleClass="altea-subtitle" text="Esdeveniments">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Label>
            <Label fx:id="txtResum" maxWidth="Infinity" styleClass="altea-slogan" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#backToConfig" styleClass="button-top" text="Configuració">
               <HBox.margin>
                  <Insets top="14.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="event-scroll" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="yPane" spacing="14.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
