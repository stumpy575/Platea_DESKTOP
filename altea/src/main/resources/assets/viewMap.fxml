<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" styleClass="color-crema" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.MapController">
   <top>
      <HBox prefHeight="40.0" prefWidth="600.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="altea-title" text="Altea">
               <font>
                  <Font name="System Bold" size="31.0" />
               </font>
            </Label>
            <Label alignment="CENTER" styleClass="altea-subtitle" text="Mapa de la sala">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Label>
            <Label maxWidth="Infinity" styleClass="altea-slogan" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#backToEvents" styleClass="button-top" text="Tornar">
               <HBox.margin>
                  <Insets top="14.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" styleClass="event-scroll" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="12.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label fx:id="txtNom" styleClass="map-title" wrapText="true" />
                  <Label fx:id="txtRecinte" styleClass="text-petit" />
                  <Label maxWidth="Infinity" styleClass="map-stage" text="ESCENARI / PANTALLA" />
                  <HBox fx:id="zonesPane" alignment="TOP_LEFT" spacing="15.0" />
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Region styleClass="seat, seat-free" />
                        <Label styleClass="text-petit" text="Lliure" />
                        <Region minWidth="10.0" />
                        <Region styleClass="seat, seat-occupied" />
                        <Label styleClass="text-petit" text="Ocupat" />
                        <Region minWidth="10.0" />
                        <Region styleClass="seat, seat-validated" />
                        <Label styleClass="text-petit" text="Validat" />
                     </children>
                  </HBox>
                  <VBox fx:id="panelVenda" managed="false" spacing="4.0" styleClass="zone-card" visible="false">
                     <children>
                        <Label fx:id="txtVendaSeient" styleClass="zone-title" />
                        <Label fx:id="txtVendaTitular" styleClass="text-petit" />
                        <Label fx:id="txtVendaComprador" styleClass="text-petit" />
                        <Label fx:id="txtVendaLocalitzador" styleClass="text-petit" />
                        <Label fx:id="txtVendaData" styleClass="text-petit" />
                        <Label fx:id="txtVendaPreu" styleClass="text-petit" />
                     </children>
                  </VBox>
                  <VBox spacing="8.0" styleClass="zone-card">
                     <children>
                        <Label fx:id="txtEntrades" styleClass="zone-title" />
                        <GridPane fx:id="entradesGrid" hgap="14.0" vgap="6.0" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
