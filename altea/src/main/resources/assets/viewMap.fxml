<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" styleClass="color-crema" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.MapController">
   <top>
      <HBox prefHeight="40.0" prefWidth="600.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="altea-title" text="Altea">
               <font>
                  <Font name="System Bold" size="31.0" />
               </font>
            </Label>
            <Label alignment="CENTER" styleClass="altea-subtitle" text="Mapa de la sala">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Label>
            <Label maxWidth="Infinity" styleClass="altea-slogan" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#backToEvents" styleClass="button-top" text="Tornar">
               <HBox.margin>
                  <Insets top="14.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="10.0" styleClass="map-placeholder">
               <StackPane.margin>
                  <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
               </StackPane.margin>
               <children>
                  <Label fx:id="txtNom" styleClass="map-title" wrapText="true" />
                  <Label fx:id="txtRecinte" styleClass="event-card-meta" />
                  <Label styleClass="map-pending" text="Mapa gràfic de la sala (pendent)" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
