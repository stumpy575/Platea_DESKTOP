<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" styleClass="event-card" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.EventCardController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label fx:id="txtCategoria" styleClass="event-card-category" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="txtData" styleClass="event-card-date" />
         </children>
      </HBox>
      <Label fx:id="txtNom" styleClass="event-card-title" wrapText="true" />
      <Label fx:id="txtRecinte" styleClass="event-card-meta" />
      <Label fx:id="txtDescripcio" styleClass="event-card-description" wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label fx:id="txtPreu" styleClass="event-card-price" />
            <Label fx:id="txtDisponibles" styleClass="event-card-meta" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnMapa" mnemonicParsing="false" onAction="#openMapa" styleClass="button-confirm" text="Veure sala" />
         </children>
      </HBox>
   </children>
</VBox>
